<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>nidelv</groupId>
  <artifactId>femkamp</artifactId>
  <version>1.0-SNAPSHOT</version>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <javafx.version>19.0.2.1</javafx.version>

    <!-- App metadata -->
    <app.name>Femkamp</app.name>
    <app.name.linux>femkamp</app.name.linux>
    <app.version>1.0</app.version>
    <app.vendor>Nidelv</app.vendor>
    <app.mainClass>nidelv.backend.App</app.mainClass>
    <app.jar>${project.artifactId}-${project.version}-jar-with-dependencies.jar</app.jar>

    <icon.linux>src/main/resources/icon.png</icon.linux>
    <icon.win>src/main/resources/icon.ico</icon.win>
    <icon.mac>src/main/resources/icon.icns</icon.mac>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.google.api-client</groupId>
      <artifactId>google-api-client</artifactId>
      <version>1.31.5</version>
    </dependency>
    <dependency>
      <groupId>com.google.api-client</groupId>
      <artifactId>google-api-client-gson</artifactId>
      <version>1.31.5</version>
    </dependency>
    <dependency>
      <groupId>com.google.api-client</groupId>
      <artifactId>google-api-client-extensions</artifactId>
      <version>1.6.0-beta</version>
    </dependency>
    <dependency>
      <groupId>com.google.oauth-client</groupId>
      <artifactId>google-oauth-client-java6</artifactId>
      <version>1.31.5</version>
    </dependency>
    <dependency>
      <groupId>com.google.oauth-client</groupId>
      <artifactId>google-oauth-client-jetty</artifactId>
      <version>1.31.5</version>
    </dependency>
    <dependency>
      <groupId>com.google.apis</groupId>
      <artifactId>google-api-services-sheets</artifactId>
      <version>v4-rev573-1.25.0</version>
    </dependency>
    <dependency>
      <groupId>com.google.http-client</groupId>
      <artifactId>google-http-client-gson</artifactId>
      <version>1.39.2</version>
    </dependency>
    <dependency>
      <groupId>com.opencsv</groupId>
      <artifactId>opencsv</artifactId>
      <version>5.5.2</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Kompilér med Java 17 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <release>17</release>
        </configuration>
      </plugin>

      <!-- Lag fat JAR -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <descriptorRefs>
            <descriptorRef>jar-with-dependencies</descriptorRef>
          </descriptorRefs>
          <archive>
            <manifest>
              <mainClass>${app.mainClass}</mainClass>
            </manifest>
          </archive>
        </configuration>
        <executions>
          <execution>
            <id>make-assembly</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Brukes for å kjøre jpackage -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
      </plugin>
    </plugins>
  </build>

  <!-- Viktig: profiles SKAL ligge her, ikke under <build> -->
  <profiles>
    <profile>
      <id>linux-deb</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>jpackage-deb</id>
                <phase>verify</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>jpackage</executable>
                  <arguments>
                    <argument>--name</argument><argument>${app.name.linux}</argument>
                    <argument>--input</argument><argument>${project.build.directory}</argument>
                    <argument>--main-jar</argument><argument>${app.jar}</argument>
                    <argument>--main-class</argument><argument>${app.mainClass}</argument>
                    <argument>--type</argument><argument>deb</argument>
                    <argument>--app-version</argument><argument>${app.version}</argument>
                    <argument>--vendor</argument><argument>${app.vendor}</argument>
                    <argument>--linux-shortcut</argument>
                    <argument>--icon</argument><argument>${icon.linux}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>linux-rpm</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>jpackage-rpm</id>
                <phase>verify</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>jpackage</executable>
                  <arguments>
                    <argument>--name</argument><argument>${app.name.linux}</argument>
                    <argument>--input</argument><argument>${project.build.directory}</argument>
                    <argument>--main-jar</argument><argument>${app.jar}</argument>
                    <argument>--main-class</argument><argument>${app.mainClass}</argument>
                    <argument>--type</argument><argument>rpm</argument>
                    <argument>--app-version</argument><argument>${app.version}</argument>
                    <argument>--vendor</argument><argument>${app.vendor}</argument>
                    <argument>--linux-shortcut</argument>
                    <argument>--icon</argument><argument>${icon.linux}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>windows-exe</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>jpackage-exe</id>
                <phase>verify</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>jpackage</executable>
                  <arguments>
                    <argument>--name</argument><argument>${app.name}</argument>
                    <argument>--input</argument><argument>${project.build.directory}</argument>
                    <argument>--main-jar</argument><argument>${app.jar}</argument>
                    <argument>--main-class</argument><argument>${app.mainClass}</argument>
                    <argument>--type</argument><argument>exe</argument>
                    <argument>--app-version</argument><argument>${app.version}</argument>
                    <argument>--vendor</argument><argument>${app.vendor}</argument>
                    <argument>--win-shortcut</argument>
                    <argument>--win-menu</argument>
                    <argument>--icon</argument><argument>${icon.win}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>mac-dmg</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>jpackage-dmg</id>
                <phase>verify</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>jpackage</executable>
                  <arguments>
                    <argument>--name</argument><argument>${app.name}</argument>
                    <argument>--input</argument><argument>${project.build.directory}</argument>
                    <argument>--main-jar</argument><argument>${app.jar}</argument>
                    <argument>--main-class</argument><argument>${app.mainClass}</argument>
                    <argument>--type</argument><argument>dmg</argument>
                    <argument>--app-version</argument><argument>${app.version}</argument>
                    <argument>--vendor</argument><argument>${app.vendor}</argument>
                    <argument>--icon</argument><argument>${icon.mac}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
